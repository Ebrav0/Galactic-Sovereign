#!/usr/bin/env bash
set -euo pipefail
credentials=/etc/galactic-sovereign/credentials
for name in immutable-upload-url immutable-upload-secret; do
  [[ -s "$credentials/$name" ]] || { echo "missing immutable archive credential: $name" >&2; exit 1; }
done
/usr/local/libexec/galactic-sovereign/gs-backup daily
archive="$(find /var/lib/galactic-sovereign/backups/daily -type f -name 'snapshot-*.tar.gz' -printf '%T@ %p\n' | sort -rn | sed -n '1s/^[^ ]* //p')"
[[ -n "$archive" ]]
filename="$(basename "$archive")"
size="$(stat -c %s "$archive")"
checksum="$(sha256sum "$archive" | cut -d' ' -f1)"
timestamp="$(date -u +%s)"
signature="$(GS_ARCHIVE_SECRET_FILE="$credentials/immutable-upload-secret" GS_ARCHIVE_NAME="$filename" GS_ARCHIVE_SIZE="$size" GS_ARCHIVE_SHA="$checksum" GS_ARCHIVE_TIME="$timestamp" node --input-type=module -e "import fs from 'node:fs';import crypto from 'node:crypto';const e=process.env;const secret=fs.readFileSync(e.GS_ARCHIVE_SECRET_FILE,'utf8').trim();process.stdout.write(crypto.createHmac('sha256',secret).update(e.GS_ARCHIVE_NAME+'\\n'+e.GS_ARCHIVE_SIZE+'\\n'+e.GS_ARCHIVE_SHA+'\\n'+e.GS_ARCHIVE_TIME).digest('hex'));" )"
curl --fail --silent --show-error --max-time 300 -X PUT \
  -H 'content-type: application/gzip' -H "x-gs-sha256: $checksum" -H "x-gs-timestamp: $timestamp" -H "x-gs-signature: $signature" \
  --data-binary "@$archive" "$(<"$credentials/immutable-upload-url")/$filename" >/dev/null
echo "immutable daily archive uploaded: $(basename "$archive")"
