#!/usr/bin/env bash
set -euo pipefail
credentials=/etc/galactic-sovereign/credentials
export RESTIC_REPOSITORY="$(<"$credentials/restic-repository")"
export RESTIC_PASSWORD_FILE="$credentials/restic-password"
export AWS_ACCESS_KEY_ID="$(<"$credentials/r2-access-key-id")"
export AWS_SECRET_ACCESS_KEY="$(<"$credentials/r2-secret-access-key")"
export RESTIC_CACHE_DIR=/var/lib/galactic-sovereign/backups/restic-cache
work="$(mktemp -d /var/tmp/gs-offsite-restore.XXXXXX)"
trap 'rm -rf -- "$work"' EXIT
restic restore latest --target "$work" --tag galactic-sovereign
archive="$(find "$work" -type f -name 'snapshot-*.tar.gz' -printf '%T@ %p\n' | sort -rn | sed -n '1s/^[^ ]* //p')"
[[ -n "$archive" ]]
extract="$work/extracted"
install -d -m 0700 "$extract"
tar -xzf "$archive" -C "$extract"
(cd "$extract" && sha256sum -c SHA256SUMS)
[[ ! -f "$extract/accounts.sqlite" ]] || [[ "$(sqlite3 "$extract/accounts.sqlite" 'PRAGMA integrity_check;')" == ok ]]
if [[ -f "$extract/world.json" ]]; then
  GS_WORLD_RESTORE_TEST="$extract/world.json" node --input-type=module -e "import fs from 'node:fs'; import { deserialize } from '/opt/galactic-sovereign/current/src/js/save.js'; const r=deserialize(fs.readFileSync(process.env.GS_WORLD_RESTORE_TEST,'utf8')); if(!r.ok) throw new Error(r.error);"
fi
install -d -m 0700 /var/lib/galactic-sovereign/backups/status
date -u +%s > /var/lib/galactic-sovereign/backups/status/offsite-restore-test.ok
echo "offsite restore test passed: $archive"
