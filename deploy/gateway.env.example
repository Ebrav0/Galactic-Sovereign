# Copy to /etc/galactic-sovereign/gateway.env with mode 0600.
# Keep production hostnames and Cloudflare identifiers out of the public repository.
GS_PUBLIC_ORIGIN=https://play.example.com
GS_ADMIN_ORIGIN=https://admin.example.com
GS_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
GS_ACCESS_AUD=replace-with-cloudflare-access-audience
GS_LOGIN_NOTIFICATION_URL=https://monitor.example.com/events/login
