#!/usr/bin/env bash
set -euo pipefail

mode="${1:-interval}"
case "$mode" in interval|daily) ;; *) echo "usage: gs-backup interval|daily" >&2; exit 2 ;; esac

data=/var/lib/galactic-sovereign
dest="$data/backups/$mode"
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
work="$(mktemp -d "$data/backups/.snapshot.XXXXXX")"
trap 'rm -rf -- "$work"' EXIT
install -d -m 0700 "$dest"

# Ask the authoritative multiplayer process to atomically flush the current
# tick before copying the world file. The one-minute autosave remains in place.
before_saved="$(curl --fail --silent --max-time 3 http://127.0.0.1:9090/health 2>/dev/null | sed -n 's/.*"lastSavedAt"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' || true)"
systemctl kill -s SIGUSR1 galactic-sovereign-coop.service 2>/dev/null || true
for attempt in {1..20}; do
  after_saved="$(curl --fail --silent --max-time 3 http://127.0.0.1:9090/health 2>/dev/null | sed -n 's/.*"lastSavedAt"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' || true)"
  [[ -n "$after_saved" && "$after_saved" != "${before_saved:-}" ]] && break
  sleep 0.1
done

if [[ -f "$data/accounts/accounts.sqlite" ]]; then
  sqlite3 "$data/accounts/accounts.sqlite" ".timeout 5000" ".backup '$work/accounts.sqlite'"
  chmod 0600 "$work/accounts.sqlite"
fi
if [[ -f "$data/multiplayer/world.json" ]]; then
  install -m 0600 "$data/multiplayer/world.json" "$work/world.json"
fi
install -d -m 0700 "$work/infrastructure"
for config in /etc/nftables.conf /etc/systemd/system/galactic-sovereign-*.service /etc/systemd/system/galactic-sovereign-*.timer; do
  [[ -f "$config" ]] || continue
  install -m 0600 "$config" "$work/infrastructure/$(basename "$config")"
done
if [[ -d /opt/galactic-sovereign/current/deploy/recovery ]]; then
  install -d -m 0700 "$work/recovery"
  find /opt/galactic-sovereign/current/deploy/recovery -maxdepth 1 -type f -print0 | while IFS= read -r -d '' file; do
    install -m 0600 "$file" "$work/recovery/$(basename "$file")"
  done
fi
if [[ -d "$data/recovery" ]]; then
  install -d -m 0700 "$work/recovery"
  find "$data/recovery" -maxdepth 1 -type f -print0 | while IFS= read -r -d '' file; do
    [[ "$(basename "$file")" =~ (secret|token|password|private|key) ]] && continue
    install -m 0600 "$file" "$work/recovery/$(basename "$file")"
  done
fi
find "$work" -maxdepth 1 -type f -print -quit | grep -q . || {
  echo 'no database or multiplayer world exists to back up' >&2
  exit 1
}
(cd "$work" && find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS)
schema_version=0
[[ ! -f "$work/accounts.sqlite" ]] || schema_version="$(sqlite3 "$work/accounts.sqlite" 'PRAGMA user_version;')"
release_id="$(basename "$(readlink -f /opt/galactic-sovereign/current 2>/dev/null || echo unknown)")"
site_release_id="$(basename "$(readlink -f /opt/galactic-sovereign/site-current 2>/dev/null || echo unavailable)")"
GS_RELEASES_PATH="$work/RELEASES.json" GS_GAME_RELEASE="$release_id" GS_SITE_RELEASE="$site_release_id" \
  node --input-type=module -e "import fs from 'node:fs';const e=process.env;fs.writeFileSync(e.GS_RELEASES_PATH,JSON.stringify({game:e.GS_GAME_RELEASE,site:e.GS_SITE_RELEASE},null,2));"
(cd "$work" && sha256sum RELEASES.json >> SHA256SUMS)
GS_MANIFEST_PATH="$work/MANIFEST.json" GS_MANIFEST_STAMP="$stamp" GS_MANIFEST_RELEASE="$release_id" GS_MANIFEST_SCHEMA="$schema_version" \
  node --input-type=module -e "import fs from 'node:fs'; import crypto from 'node:crypto'; const root=new URL('file://' + process.env.GS_MANIFEST_PATH).pathname.replace(/\/MANIFEST.json$/,''); const files=[]; const walk=(d)=>{for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=d+'/'+e.name;if(e.isDirectory())walk(p);else if(!['MANIFEST.json','SHA256SUMS'].includes(e.name)){const b=fs.readFileSync(p);files.push({path:p.slice(root.length+1),size:b.length,sha256:crypto.createHash('sha256').update(b).digest('hex')});}}};walk(root);fs.writeFileSync(process.env.GS_MANIFEST_PATH,JSON.stringify({formatVersion:1,createdAt:process.env.GS_MANIFEST_STAMP,releaseId:process.env.GS_MANIFEST_RELEASE,schemaVersion:Number(process.env.GS_MANIFEST_SCHEMA||0),files},null,2));"
(cd "$work" && sha256sum MANIFEST.json >> SHA256SUMS)
tar -C "$work" -czf "$dest/.snapshot-$stamp.tar.gz.tmp" .
chmod 0600 "$dest/.snapshot-$stamp.tar.gz.tmp"
mv "$dest/.snapshot-$stamp.tar.gz.tmp" "$dest/snapshot-$stamp.tar.gz"

if [[ "$mode" == interval ]]; then
  find "$dest" -type f -name 'snapshot-*.tar.gz' -printf '%T@ %p\n' | sort -rn | tail -n +97 | cut -d' ' -f2- | xargs -r rm --
else
  find "$dest" -type f -name 'snapshot-*.tar.gz' -printf '%T@ %p\n' | sort -rn | tail -n +15 | cut -d' ' -f2- | xargs -r rm --
fi
echo "backup $mode complete: $dest/snapshot-$stamp.tar.gz"
