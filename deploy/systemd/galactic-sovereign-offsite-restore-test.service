[Unit]
Description=Monthly Galactic Sovereign clean-room restore from R2
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/galactic-sovereign/gs-offsite-restore-test
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/galactic-sovereign/backups/status /var/tmp
UMask=0077
