[Unit]
Description=Daily immutable Galactic Sovereign recovery archive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/galactic-sovereign/gs-immutable-archive
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/galactic-sovereign/backups
UMask=0077
