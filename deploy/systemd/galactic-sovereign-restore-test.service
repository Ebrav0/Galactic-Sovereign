[Unit]
Description=Weekly Galactic Sovereign isolated restore test

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/galactic-sovereign/gs-restore-test
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/galactic-sovereign/backups/status /var/tmp
UMask=0077
