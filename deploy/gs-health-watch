#!/usr/bin/env bash
# Loopback health probe with rate-limited automatic restarts.
set -euo pipefail

state_dir=/run/galactic-sovereign-health
install -d -m 0755 "$state_dir"
now="$(date +%s)"
window=900
max_restarts=3

may_restart() {
  local unit="$1"
  local stamp="$state_dir/${unit}.restarts"
  local count=0
  if [[ -f "$stamp" ]]; then
    while IFS=' ' read -r ts; do
      [[ -n "$ts" ]] || continue
      if (( now - ts < window )); then
        count=$((count + 1))
        echo "$ts"
      fi
    done <"$stamp" >"$stamp.tmp" || true
    mv -f "$stamp.tmp" "$stamp"
  else
    : >"$stamp"
  fi
  if (( count >= max_restarts )); then
    echo "health-watch: refusing further restarts of $unit (${count} in ${window}s)" >&2
    return 1
  fi
  echo "$now" >>"$stamp"
  return 0
}

restart_unit() {
  local unit="$1"
  may_restart "$unit" || return 0
  echo "health-watch: restarting $unit"
  systemctl restart "$unit"
}

gateway_ok=0
coop_ok=0
coop_players=0
site_ok=1
if curl --fail --silent --max-time 3 http://127.0.0.1:8080/healthz >/dev/null; then
  gateway_ok=1
else
  restart_unit galactic-sovereign-gateway.service
fi

if systemctl is-enabled --quiet galactic-sovereign-site.service 2>/dev/null; then
  if curl --fail --silent --max-time 3 http://127.0.0.1:8081/healthz >/dev/null; then
    site_ok=1
  else
    site_ok=0
    restart_unit galactic-sovereign-site.service
  fi
fi

if coop_health="$(curl --fail --silent --max-time 3 http://127.0.0.1:9090/health)"; then
  coop_ok=1
  coop_players="$(node -e "let s='';process.stdin.on('data',c=>s+=c).on('end',()=>{try{const n=Number(JSON.parse(s).playersOnline);process.stdout.write(String(Number.isFinite(n)?n:0))}catch{process.stdout.write('0')}})" <<<"$coop_health")"
else
  restart_unit galactic-sovereign-coop.service
fi

# Tunnel can look healthy while gateway is dead; only bounce cloudflared when
# loopback gateway is fine but the public edge still fails.
if [[ "$gateway_ok" -eq 1 ]] \
  && [[ -s /etc/galactic-sovereign/credentials/cloudflare-tunnel-token ]] \
  && systemctl is-enabled --quiet cloudflared-galactic-sovereign.service 2>/dev/null; then
  if ! curl --fail --silent --max-time 8 https://play.galacticsovereign.xyz/healthz >/dev/null; then
    restart_unit cloudflared-galactic-sovereign.service
  fi
fi

# Soft hygiene signals (non-fatal).
usage="$(df -P / | awk 'NR==2 {gsub(/%/,"",$5); print $5}')"
if [[ "$usage" =~ ^[0-9]+$ ]] && (( usage >= 85 )); then
  echo "health-watch: disk usage ${usage}% on /" >&2
fi
newest="$(find /var/lib/galactic-sovereign/backups -type f -name 'snapshot-*.tar.gz' -printf '%T@\n' 2>/dev/null | sort -rn | head -n1 || true)"
if [[ -n "${newest:-}" ]]; then
  age=$(( now - ${newest%.*} ))
  if (( age > 1800 )); then
    echo "health-watch: newest local backup is ${age}s old" >&2
  fi
fi

backup_age="${age:-999999999}"
tunnel_ok=0
systemctl is-active --quiet cloudflared-galactic-sovereign.service && tunnel_ok=1
firewall_ok=0
if nft list table inet gs_filter >/dev/null 2>&1; then
  configured_hash="$(sha256sum /opt/galactic-sovereign/current/deploy/nftables-galactic-sovereign.nft 2>/dev/null | cut -d' ' -f1 || true)"
  expected_hash="$(cat /var/lib/galactic-sovereign/firewall/expected.sha256 2>/dev/null || true)"
  [[ -n "$configured_hash" && "$configured_hash" == "$expected_hash" ]] && firewall_ok=1
fi
restore_test_at="$(cat /var/lib/galactic-sovereign/backups/status/local-restore-test.ok 2>/dev/null || echo 0)"
offsite_restore_at="$(cat /var/lib/galactic-sovereign/backups/status/offsite-restore-test.ok 2>/dev/null || echo 0)"
ups_state=unavailable
if command -v upsc >/dev/null 2>&1; then
  ups_name="$(upsc -l 2>/dev/null | head -n1 || true)"
  [[ -z "$ups_name" ]] || ups_state="$(upsc "$ups_name" ups.status 2>/dev/null || echo unknown)"
fi
release_id="$(basename "$(readlink -f /opt/galactic-sovereign/current 2>/dev/null || echo unknown)")"
site_release_id="$(basename "$(readlink -f /opt/galactic-sovereign/site-current 2>/dev/null || echo unavailable)")"

# Persist only sanitized operational telemetry for the owner dashboard. Daily
# JSONL partitions make 30-day charts cheap to read and simple to expire.
health_dir=/var/lib/galactic-sovereign/health
install -d -o root -g galactic-sovereign -m 0750 "$health_dir"
payload="$(mktemp /run/gs-heartbeat.XXXXXX.json)"
trap 'rm -f -- "$payload"' EXIT
GS_HEARTBEAT_PATH="$payload" GS_HEARTBEAT_NOW="$now" GS_HEARTBEAT_GATEWAY="$gateway_ok" GS_HEARTBEAT_COOP="$coop_ok" \
  GS_HEARTBEAT_SITE="$site_ok" GS_HEARTBEAT_TUNNEL="$tunnel_ok" GS_HEARTBEAT_BACKUP_AGE="$backup_age" \
  GS_HEARTBEAT_DISK="$usage" GS_HEARTBEAT_FIREWALL="$firewall_ok" GS_HEARTBEAT_RESTORE="$restore_test_at" \
  GS_HEARTBEAT_OFFSITE_RESTORE="$offsite_restore_at" GS_HEARTBEAT_UPS="$ups_state" GS_HEARTBEAT_RELEASE="$release_id" \
  GS_HEARTBEAT_SITE_RELEASE="$site_release_id" GS_HEARTBEAT_PLAYERS="$coop_players" node --input-type=module -e "import fs from 'node:fs'; const e=process.env; fs.writeFileSync(e.GS_HEARTBEAT_PATH,JSON.stringify({timestamp:Number(e.GS_HEARTBEAT_NOW),services:{gateway:e.GS_HEARTBEAT_GATEWAY==='1',coop:e.GS_HEARTBEAT_COOP==='1',site:e.GS_HEARTBEAT_SITE==='1',tunnel:e.GS_HEARTBEAT_TUNNEL==='1'},backupAgeSeconds:Number(e.GS_HEARTBEAT_BACKUP_AGE),diskUsePercent:Number(e.GS_HEARTBEAT_DISK),firewallOk:e.GS_HEARTBEAT_FIREWALL==='1',restoreTestAt:Number(e.GS_HEARTBEAT_RESTORE),offsiteRestoreTestAt:Number(e.GS_HEARTBEAT_OFFSITE_RESTORE),upsState:e.GS_HEARTBEAT_UPS,release:e.GS_HEARTBEAT_RELEASE,siteRelease:e.GS_HEARTBEAT_SITE_RELEASE,playersOnline:Number(e.GS_HEARTBEAT_PLAYERS)}));"
install -o root -g galactic-sovereign -m 0640 "$payload" "$health_dir/latest.json"
history="$health_dir/metrics-$(date -u +%F).jsonl"
touch "$history"
chown root:galactic-sovereign "$history"
chmod 0640 "$history"
printf '%s\n' "$(<"$payload")" >>"$history"
find "$health_dir" -maxdepth 1 -type f -name 'metrics-*.jsonl' -mtime +31 -delete

# Local probes stay on the 60s timer; Cloudflare KV writes are throttled so the
# free-plan 1,000 writes/day budget is not exhausted (~288 writes/day at 5 min).
monitor_interval=300
monitor_stamp="$state_dir/monitor-heartbeat.sent"
heartbeat_url_file=/etc/galactic-sovereign/credentials/monitor-heartbeat-url
heartbeat_secret_file=/etc/galactic-sovereign/credentials/monitor-heartbeat-secret
send_monitor=0
if [[ -s "$heartbeat_url_file" && -s "$heartbeat_secret_file" ]]; then
  send_monitor=1
  if [[ -f "$monitor_stamp" ]]; then
    read -r last_sent <"$monitor_stamp" || last_sent=
    if [[ "$last_sent" =~ ^[0-9]+$ ]] && (( now - last_sent < monitor_interval )); then
      send_monitor=0
    fi
  fi
fi
if (( send_monitor )); then
  signature="$(GS_HEARTBEAT_PATH="$payload" GS_HEARTBEAT_SECRET_FILE="$heartbeat_secret_file" node --input-type=module -e "import fs from 'node:fs'; import crypto from 'node:crypto'; const secret=fs.readFileSync(process.env.GS_HEARTBEAT_SECRET_FILE,'utf8').trim(); process.stdout.write(crypto.createHmac('sha256',secret).update(fs.readFileSync(process.env.GS_HEARTBEAT_PATH)).digest('hex'));" )"
  curl --fail --silent --max-time 8 -H 'content-type: application/json' -H "x-gs-signature: $signature" --data-binary "@$payload" "$(<"$heartbeat_url_file")" >/dev/null
  printf '%s\n' "$now" >"$monitor_stamp"
fi

[[ "$gateway_ok" -eq 1 && "$coop_ok" -eq 1 && "$site_ok" -eq 1 ]]
