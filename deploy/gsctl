#!/usr/bin/env bash
set -euo pipefail

releases=/opt/galactic-sovereign/releases
current=/opt/galactic-sovereign/current
site_releases=/opt/galactic-sovereign/site-releases
site_current=/opt/galactic-sovereign/site-current
credentials=/etc/galactic-sovereign/credentials
command="${1:-status}"
release_id="${2:-}"

valid_release() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{5,79}$ ]]; }
require_release() { valid_release "$release_id" || { echo 'invalid release id' >&2; exit 2; }; }

has_restic_credentials() {
  [[ -s "$credentials/restic-password" && \
     -s "$credentials/r2-access-key-id" && \
     -s "$credentials/r2-secret-access-key" && \
     -s "$credentials/restic-repository" ]]
}

ensure_service_accounts() {
  getent group galactic-sovereign-site >/dev/null || groupadd --system galactic-sovereign-site
  id galactic-sovereign-site >/dev/null 2>&1 || useradd --system --gid galactic-sovereign-site --home-dir /nonexistent --shell /usr/sbin/nologin galactic-sovereign-site
}

ensure_units() {
  ensure_service_accounts
  systemctl daemon-reload
  systemctl enable galactic-sovereign-coop.service galactic-sovereign-gateway.service galactic-sovereign-admin-ops.service
  if [[ -L "$site_current" && -f "$site_current/server.mjs" ]]; then
    systemctl enable galactic-sovereign-site.service
    systemctl restart galactic-sovereign-site.service
  fi
  systemctl enable \
    galactic-sovereign-backup.timer \
    galactic-sovereign-daily.timer \
    galactic-sovereign-restore-test.timer \
    galactic-sovereign-health.timer
  systemctl start \
    galactic-sovereign-backup.timer \
    galactic-sovereign-daily.timer \
    galactic-sovereign-restore-test.timer \
    galactic-sovereign-health.timer

  if [[ -s "$credentials/cloudflare-tunnel-token" ]]; then
    systemctl enable cloudflared-galactic-sovereign.service
    systemctl restart cloudflared-galactic-sovereign.service
  else
    echo 'ensure-units: tunnel token missing; leaving cloudflared disabled' >&2
  fi

  if has_restic_credentials; then
    systemctl enable --now galactic-sovereign-restic.timer galactic-sovereign-restic-hourly.timer galactic-sovereign-restic-maintain.timer galactic-sovereign-offsite-restore-test.timer
  else
    systemctl disable --now galactic-sovereign-restic.timer galactic-sovereign-restic-hourly.timer galactic-sovereign-restic-maintain.timer galactic-sovereign-offsite-restore-test.timer 2>/dev/null || true
  fi
  if [[ -s "$credentials/immutable-upload-url" && -s "$credentials/immutable-upload-secret" ]]; then
    systemctl enable --now galactic-sovereign-immutable-archive.timer
  else
    systemctl disable --now galactic-sovereign-immutable-archive.timer 2>/dev/null || true
  fi

  systemctl restart galactic-sovereign-coop.service galactic-sovereign-gateway.service
  systemctl restart galactic-sovereign-admin-ops.service
  if command -v tailscale >/dev/null; then
    systemctl enable --now tailscaled.service 2>/dev/null || true
    tailscale set --ssh --accept-risk=lose-ssh 2>/dev/null || true
  fi
}

case "$command" in
  deploy)
    require_release
    archive="/var/tmp/galactic-sovereign-$release_id.tar.gz"
    sums="$archive.sha256"
    [[ -f "$archive" && -f "$sums" ]] || { echo "missing release archive or checksum" >&2; exit 1; }
    (cd /var/tmp && sha256sum -c "$(basename "$sums")")
    release="$releases/$release_id"
    [[ ! -e "$release" ]] || { echo 'release already exists' >&2; exit 1; }
    stage="$releases/.staging-$release_id"
    trap 'rm -rf -- "$stage"' EXIT
    install -d -m 0755 "$stage"
    while IFS= read -r member; do
      [[ "$member" =~ ^[A-Za-z0-9._/-]+$ && "$member" != /* && "$member" != ../* && "$member" != */../* ]] || {
        echo "unsafe release member: $member" >&2
        exit 1
      }
    done < <(tar -tzf "$archive")
    tar -xzf "$archive" -C "$stage" --no-same-owner --no-same-permissions
    [[ -f "$stage/package.json" && -f "$stage/package-lock.json" && -f "$stage/server/app-host.mjs" ]] || {
      echo 'release is missing required files' >&2
      exit 1
    }
    if find "$stage" -type l -print -quit | grep -q .; then
      echo 'release symlinks are not allowed' >&2
      exit 1
    fi
    chown -R galactic-sovereign:galactic-sovereign "$stage"
    runuser -u galactic-sovereign -- bash -lc \
      'cd "$1" && npm ci --omit=dev --ignore-scripts && node --check server/app-host.mjs && node --check server/coop-host.mjs' \
      _ "$stage"
    chown -R root:root "$stage"
    find "$stage" -type d -exec chmod 0755 {} +
    find "$stage" -type f -exec chmod 0644 {} +
    mv "$stage" "$release"
    trap - EXIT
    legacy_world=/var/lib/galactic-sovereign/pre-migration/original-world.json
    live_world=/var/lib/galactic-sovereign/multiplayer/world.json
    if [[ -f "$legacy_world" && ! -e "$live_world" ]]; then
      GS_DATA_DIR=/var/lib/galactic-sovereign/accounts \
        node "$release/scripts/migrate-multiplayer-world.mjs" "$legacy_world" "$live_world"
      chown -R galactic-sovereign:galactic-sovereign \
        /var/lib/galactic-sovereign/accounts /var/lib/galactic-sovereign/multiplayer
      chmod 0700 /var/lib/galactic-sovereign/accounts /var/lib/galactic-sovereign/multiplayer
      find /var/lib/galactic-sovereign/accounts /var/lib/galactic-sovereign/multiplayer -type f -exec chmod 0600 {} +
    fi
    # Refresh ops binaries and units from the release when present.
    if [[ -d "$release/deploy" ]]; then
      install -o root -g root -m 0755 "$release/deploy/gsctl" /usr/local/sbin/gsctl
      install -o root -g root -m 0755 "$release/deploy/gs-backup" /usr/local/libexec/galactic-sovereign/gs-backup
      install -o root -g root -m 0755 "$release/deploy/gs-offsite-backup" /usr/local/libexec/galactic-sovereign/gs-offsite-backup
      install -o root -g root -m 0755 "$release/deploy/gs-restore-test" /usr/local/libexec/galactic-sovereign/gs-restore-test
      install -o root -g root -m 0755 "$release/deploy/gs-restore" /usr/local/libexec/galactic-sovereign/gs-restore
      install -o root -g root -m 0755 "$release/deploy/gs-health-watch" /usr/local/libexec/galactic-sovereign/gs-health-watch
      install -o root -g root -m 0755 "$release/deploy/gs-restic-maintain" /usr/local/libexec/galactic-sovereign/gs-restic-maintain
      install -o root -g root -m 0755 "$release/deploy/gs-offsite-restore-test" /usr/local/libexec/galactic-sovereign/gs-offsite-restore-test
      install -o root -g root -m 0755 "$release/deploy/gs-immutable-archive" /usr/local/libexec/galactic-sovereign/gs-immutable-archive
      install -o root -g root -m 0755 "$release/deploy/gs-firewall-apply" /usr/local/libexec/galactic-sovereign/gs-firewall-apply
      install -o root -g root -m 0755 "$release/deploy/gs-firewall-rollback" /usr/local/libexec/galactic-sovereign/gs-firewall-rollback
      install -o root -g root -m 0755 "$release/deploy/gs-admin-ops-broker.mjs" /usr/local/libexec/galactic-sovereign/gs-admin-ops-broker.mjs
      install -o root -g root -m 0644 "$release/deploy/systemd/"* /etc/systemd/system/
    fi
    ln -sfn "$release" "$releases/.current-$release_id"
    mv -Tf "$releases/.current-$release_id" "$current"
    systemctl disable --now galactic-sovereign-web.service 2>/dev/null || true
    ensure_units
    for attempt in {1..20}; do
      curl --fail --silent http://127.0.0.1:8080/healthz >/dev/null && break
      [[ "$attempt" -lt 20 ]] || { echo 'gateway health check timed out' >&2; exit 1; }
      sleep 0.25
    done
    /usr/local/libexec/galactic-sovereign/gs-backup daily
    ;;
  site-deploy)
    require_release
    ensure_service_accounts
    archive="/var/tmp/galactic-sovereign-site-$release_id.tar.gz"
    sums="$archive.sha256"
    [[ -f "$archive" && -f "$sums" ]] || { echo 'missing site archive or checksum' >&2; exit 1; }
    (cd /var/tmp && sha256sum -c "$(basename "$sums")")
    install -d -o root -g root -m 0755 "$site_releases"
    release="$site_releases/$release_id"
    [[ ! -e "$release" ]] || { echo 'site release already exists' >&2; exit 1; }
    stage="$site_releases/.staging-$release_id"
    trap 'rm -rf -- "$stage"' EXIT
    install -d -o root -g root -m 0755 "$stage"
    while IFS= read -r member; do
      [[ "$member" =~ ^[A-Za-z0-9._/-]+$ && "$member" != /* && "$member" != ../* && "$member" != */../* ]] || { echo "unsafe site release member: $member" >&2; exit 1; }
    done < <(tar -tzf "$archive")
    tar -xzf "$archive" -C "$stage" --no-same-owner --no-same-permissions
    [[ -f "$stage/server.mjs" && -f "$stage/dist/client/index.html" ]] || { echo 'site release is missing required files' >&2; exit 1; }
    [[ -z "$(find "$stage" -type l -print -quit)" ]] || { echo 'site release symlinks are not allowed' >&2; exit 1; }
    chown -R root:root "$stage"
    find "$stage" -type d -exec chmod 0755 {} +
    find "$stage" -type f -exec chmod 0644 {} +
    mv "$stage" "$release"
    trap - EXIT
    ln -sfn "$release" "$site_releases/.current-$release_id"
    mv -Tf "$site_releases/.current-$release_id" "$site_current"
    systemctl daemon-reload
    systemctl enable galactic-sovereign-site.service
    systemctl restart galactic-sovereign-site.service
    for attempt in {1..30}; do
      curl --fail --silent http://127.0.0.1:8081/healthz >/dev/null && break
      [[ "$attempt" -lt 30 ]] || { echo 'site health check timed out' >&2; exit 1; }
      sleep 0.25
    done
    ;;
  site-rollback)
    require_release
    release="$site_releases/$release_id"
    [[ -d "$release" && -f "$release/server.mjs" ]] || { echo 'site release not found' >&2; exit 1; }
    ln -sfn "$release" "$site_releases/.current-$release_id"
    mv -Tf "$site_releases/.current-$release_id" "$site_current"
    systemctl restart galactic-sovereign-site.service
    curl --fail --silent http://127.0.0.1:8081/healthz >/dev/null
    ;;
  site-cleanup)
    keep="${2:-5}"
    [[ "$keep" =~ ^[1-9][0-9]?$ ]] || exit 2
    current_site="$(readlink -f "$site_current" 2>/dev/null || true)"
    mapfile -t old_sites < <(find "$site_releases" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2- | tail -n "+$((keep + 1))")
    for old_site in "${old_sites[@]:-}"; do
      [[ -n "$old_site" && "$old_site" != "$current_site" && "$old_site" == "$site_releases/"* ]] || continue
      rm -rf -- "$old_site"
    done
    ;;
  ensure-units)
    ensure_units
    ;;
  rollback)
    require_release
    if [[ "$release_id" == legacy ]]; then
      config=/etc/galactic-sovereign/legacy.env
      [[ -r "$config" ]] || { echo 'legacy rollback configuration missing' >&2; exit 1; }
      # shellcheck disable=SC1090
      source "$config"
      [[ "$GS_LEGACY_WORLD_PATH" =~ ^/[A-Za-z0-9._/-]+$ && "$GS_LEGACY_WORLD_PATH" != / ]] || exit 2
      /usr/local/libexec/galactic-sovereign/gs-backup daily || true
      systemctl stop galactic-sovereign-gateway.service galactic-sovereign-coop.service
      install -m 0600 /var/lib/galactic-sovereign/pre-migration/original-world.json "$GS_LEGACY_WORLD_PATH"
      for unit in galactic-sovereign-web.service galactic-sovereign-coop.service; do
        [[ ! -f "/var/lib/galactic-sovereign/pre-migration/$unit" ]] || \
          install -m 0644 "/var/lib/galactic-sovereign/pre-migration/$unit" "/etc/systemd/system/$unit"
      done
      systemctl daemon-reload
      systemctl enable --now galactic-sovereign-web.service galactic-sovereign-coop.service
      exit 0
    fi
    release="$releases/$release_id"
    [[ -d "$release" ]] || { echo 'release not found' >&2; exit 1; }
    ln -sfn "$release" "$releases/.current-$release_id"
    mv -Tf "$releases/.current-$release_id" "$current"
    ensure_units
    ;;
  status)
    readlink -f "$current" || true
    systemctl --no-pager --full status \
      galactic-sovereign-gateway.service \
      galactic-sovereign-coop.service \
      galactic-sovereign-site.service \
      galactic-sovereign-admin-ops.service \
      cloudflared-galactic-sovereign.service || true
    systemctl list-timers --all --no-pager \
      'galactic-sovereign*' 'cloudflared-galactic-sovereign*' 2>/dev/null || true
    ;;
  logs)
    service="${2:-gateway}"
    case "$service" in
      gateway) unit=galactic-sovereign-gateway.service ;;
      coop) unit=galactic-sovereign-coop.service ;;
      site) unit=galactic-sovereign-site.service ;;
      tunnel) unit=cloudflared-galactic-sovereign.service ;;
      health) unit=galactic-sovereign-health.service ;;
      *) exit 2 ;;
    esac
    journalctl -u "$unit" --since '-2 hours' --no-pager -n 300
    ;;
  backup) /usr/local/libexec/galactic-sovereign/gs-backup daily ;;
  offsite-backup) /usr/local/libexec/galactic-sovereign/gs-offsite-backup interval ;;
  restore-test) /usr/local/libexec/galactic-sovereign/gs-restore-test ;;
  restore)
    snapshot="${2:-latest}"
    /usr/local/libexec/galactic-sovereign/gs-restore "$snapshot"
    ;;
  restart)
    systemctl restart galactic-sovereign-coop.service galactic-sovereign-gateway.service
    if systemctl is-enabled --quiet galactic-sovereign-site.service 2>/dev/null; then systemctl restart galactic-sovereign-site.service; fi
    if systemctl is-enabled --quiet cloudflared-galactic-sovereign.service 2>/dev/null; then
      systemctl restart cloudflared-galactic-sovereign.service
    fi
    ;;
  site-status)
    readlink -f "$site_current" || true
    systemctl --no-pager --full status galactic-sovereign-site.service || true
    curl --fail --silent --show-error http://127.0.0.1:8081/healthz
    ;;
  site-health) curl --fail --silent --show-error http://127.0.0.1:8081/healthz ;;
  site-restart) systemctl restart galactic-sovereign-site.service ;;
  firewall-apply) /usr/local/libexec/galactic-sovereign/gs-firewall-apply ;;
  firewall-confirm)
    state=/var/lib/galactic-sovereign/firewall
    [[ -f "$state/pending" ]] || { echo 'no pending firewall change' >&2; exit 1; }
    curl --fail --silent --max-time 8 https://play.galacticsovereign.xyz/healthz >/dev/null
    curl --fail --silent --max-time 3 http://127.0.0.1:8080/healthz >/dev/null
    curl --fail --silent --max-time 3 http://127.0.0.1:9090/health >/dev/null
    tailscale status --json | grep -q '"BackendState": "Running"'
    systemctl stop gs-firewall-rollback.timer gs-firewall-rollback.service 2>/dev/null || true
    systemctl reset-failed gs-firewall-rollback.service 2>/dev/null || true
    rm -f "$state/pending"
    if command -v ufw >/dev/null; then ufw --force disable; systemctl disable ufw.service 2>/dev/null || true; fi
    echo 'firewall confirmed; UFW disabled and nftables is authoritative'
    ;;
  firewall-rollback) /usr/local/libexec/galactic-sovereign/gs-firewall-rollback ;;
  firewall-status)
    state=/var/lib/galactic-sovereign/firewall
    [[ ! -f "$state/pending" ]] || echo 'status: pending confirmation'
    nft list table inet gs_filter
    printf 'configured_sha256='; sha256sum /opt/galactic-sovereign/current/deploy/nftables-galactic-sovereign.nft | cut -d' ' -f1
    printf 'expected_sha256='; cat "$state/expected.sha256" 2>/dev/null || true
    ;;
  credential-install)
    name="${2:-}"
    case "$name" in monitor-heartbeat-url|monitor-heartbeat-secret|immutable-upload-url|immutable-upload-secret) ;; *) echo 'credential name is not allowed' >&2; exit 2 ;; esac
    source_file="/var/tmp/gs-credential-$name"
    [[ -s "$source_file" && ! -L "$source_file" ]] || { echo 'staged credential is missing' >&2; exit 1; }
    install -o root -g root -m 0600 "$source_file" "$credentials/$name"
    rm -f -- "$source_file"
    ensure_units
    ;;
  *)
    echo 'usage: gsctl deploy ID|rollback ID|site-deploy ID|site-rollback ID|site-cleanup [KEEP]|site-status|site-health|site-restart|firewall-apply|firewall-confirm|firewall-rollback|firewall-status|credential-install NAME|ensure-units|status|logs [gateway|coop|site|tunnel|health]|backup|offsite-backup|restore-test|restore [latest|PATH|NAME]|restart' >&2
    exit 2
    ;;
esac
