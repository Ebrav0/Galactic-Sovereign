{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "galactic-sovereign-monitor-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./mobile/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "HEALTH", "id": "00000000000000000000000000000000" }
  ],
  "r2_buckets": [
    { "binding": "ARCHIVE", "bucket_name": "galactic-sovereign-local-archive" }
  ],
  "send_email": [
    {
      "name": "ALERT_EMAIL",
      "destination_address": "owner@example.com",
      "allowed_sender_addresses": ["alerts@example.com"]
    }
  ],
  "vars": {
    "ALERT_TO": "owner@example.com",
    "ALERT_FROM": "alerts@example.com",
    "MONITOR_HOST": "localhost",
    "MOBILE_HOST": "localhost",
    "TEAM_DOMAIN": "https://example.cloudflareaccess.com",
    "POLICY_AUD": "replace-with-mobile-access-audience",
    "LOCAL_DEV_BYPASS": "1"
  }
}
