{
  "name": "galactic-sovereign-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types --env-file .dev.vars.example",
    "dev": "npm run build:mobile && wrangler dev --config wrangler.dev.jsonc --local --port 8787 --env-file .dev.vars.example",
    "build:mobile": "vite build --config mobile/vite.config.ts",
    "preview:mobile": "vite preview --config mobile/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p mobile/tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build:mobile && npm run types && npm run typecheck && npm test && wrangler deploy --dry-run",
    "deploy": "npm run build:mobile && wrangler deploy --config wrangler.production.jsonc"
  },
  "dependencies": {
    "@fontsource/orbitron": "^5.2.8",
    "@fontsource/rajdhani": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "jose": "^6.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wrangler": "^4.114.0"
  }
}
