{
  "name": "galactic-sovereign-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types --env-file .dev.vars.example",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run types && npm run typecheck && npm test && wrangler deploy --dry-run",
    "deploy": "wrangler deploy --config wrangler.production.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^24.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.113.0"
  }
}
