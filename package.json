{
  "name": "galactic-sovereign",
  "version": "0.1.0",
  "description": "Lane-based galactic strategy game — Electron + HTML5 Canvas",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:standalone": "vite build --config vite.standalone.config.js",
    "build:admin": "npm --prefix admin run build",
    "build": "npm run build:standalone && vite build && npm run build:admin",
    "verify:supabase-saves": "node scripts/verify-supabase-saves.mjs",
    "verify:hosted-supabase-autosave": "node scripts/verify-hosted-supabase-autosave.mjs",
    "wipe:solo-saves": "node scripts/wipe-ct-solo-saves.mjs",
    "ops:ct-disk-prune": "node scripts/ct-disk-prune-checklist.mjs",
    "app": "node server/app-host.mjs",
    "admin:create": "node server/admin-cli.mjs create-owner",
    "verify:hosted-auth": "node scripts/verify-hosted-auth.mjs",
    "verify:login-notifications": "node scripts/verify-login-notifications.mjs",
    "verify:hosted-ui": "node scripts/verify-hosted-ui.mjs",
    "verify:hosted-load": "node scripts/verify-hosted-load.mjs",
    "verify:coop-movement-core": "node scripts/verify-coop-movement-core.mjs",
    "verify:coop-movement": "node scripts/verify-coop-movement-quality.mjs",
    "verify:world-migration": "node scripts/verify-world-migration.mjs",
    "verify:tutorial": "node scripts/verify-tutorial-foundations.mjs",
    "verify:tutorial:browsers": "node scripts/verify-tutorial-browsers.mjs",
    "verify:command-deck": "node scripts/verify-command-deck.mjs",
    "verify:command-deck:browser": "node scripts/verify-command-deck-browser.mjs",
    "verify:tech-locks": "node scripts/verify-tech-locks.mjs && node scripts/verify-tech-lock-ui.mjs",
    "verify:solo-ete-performance": "node scripts/verify-solo-ete-performance.mjs",
    "verify:dyson-site-reuse": "node scripts/verify-dyson-visual-site-reuse.mjs",
    "verify:browser-save-compression": "node scripts/verify-browser-save-compression.mjs",
    "verify:logistics": "node scripts/verify-logistics-v2.mjs",
    "verify:logistics:browser": "node scripts/verify-logistics-controls-browser.mjs",
    "verify:system-play": "node scripts/verify-system-play.mjs",
    "verify:campaign-content": "node scripts/verify-campaign-content.mjs",
    "verify:campaign-content:browser": "node scripts/verify-campaign-content-browser.mjs",
    "verify:security": "node scripts/verify-security-hardening.mjs",
    "verify:access-auth": "node scripts/verify-access-auth.mjs",
    "verify:admin-host": "node scripts/verify-admin-host.mjs",
    "electron:prod": "npm run build && electron .",
    "coop": "node server/coop-host.mjs",
    "coop:smoke": "node scripts/coop-smoke.mjs",
    "coop:gate": "node scripts/coop-gate.mjs",
    "coop:ship": "node scripts/coop-ship-readiness.mjs",
    "coop:fps": "node scripts/coop-fps-probe.mjs",
    "coop:reset": "GS_COOP_RESET=1 node server/coop-host.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.1",
    "vite": "^8.1.3",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@supabase/supabase-js": "^2.112.0",
    "jose": "^6.2.4",
    "ws": "^8.21.1"
  }
}
