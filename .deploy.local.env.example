# Copy to .deploy.local.env (ignored) and keep it only on the administrator workstation.
GS_PVE_SSH_HOST=proxmox-tailnet-host
GS_PVE_CT_ID=123
GS_PVE_BACKUP_STORAGE=backup-storage-name
GS_RELEASE_OUTPUT_DIR=/absolute/local/path/outside-the-repository
GS_LEGACY_WORLD_PATH=/absolute/path/to/existing/world.json
GS_LEGACY_RELEASE_PATH=/absolute/path/to/existing/release

# Cloudflare provisioning. Identifiers are private deployment configuration;
# the API token is a secret.
CLOUDFLARE_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_TUNNEL_ID=
CF_ACCESS_OWNER_EMAIL=
CF_SITE_HOSTNAME=galacticsovereign.xyz
CF_SITE_SERVICE=http://127.0.0.1:8081
